// Convoca data model. Migrated from schema.sql to Prisma + Railway Postgres.
// pgvector lives via the postgresqlExtensions preview feature.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model City {
  slug             String        @id
  display_name     String
  country          String
  default_language String
  center_lat       Decimal       @db.Decimal(9, 6)
  center_lng       Decimal       @db.Decimal(9, 6)
  timezone         String

  sources       Source[]
  events        Event[]
  flags         EventFlag[]
  submissions   Submission[]
  user_sessions UserSession[]

  @@map("cities")
}

model Source {
  id                    String   @id @default(uuid()) @db.Uuid
  city_slug             String?
  borough               String?
  ingest_method         String
  source_url            String?
  display_name          String
  bio                   String?
  civic_relevance       Decimal? @db.Decimal(3, 2)
  source_category       String[] @default([])
  primary_causes        String[] @default([])
  language              String   @default("en")
  monitoring_status     String   @default("active")
  poll_interval_minutes Int      @default(60)
  last_polled_at        DateTime? @db.Timestamptz(6)
  discovered_via        String?  @db.Uuid
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  city          City?     @relation(fields: [city_slug], references: [slug])
  raw_posts     RawPost[]
  parent        Source?   @relation("SourceLineage", fields: [discovered_via], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children      Source[]  @relation("SourceLineage")

  @@unique([ingest_method, source_url])
  @@map("sources")
}

model RawPost {
  id               String    @id @default(uuid()) @db.Uuid
  source_id        String?   @db.Uuid
  external_id      String?
  url              String?
  posted_at        DateTime? @db.Timestamptz(6)
  text_content     String?
  image_urls       String[]  @default([])
  has_event_signal Boolean   @default(false)
  is_in_scope      Boolean?
  fetched_at       DateTime  @default(now()) @db.Timestamptz(6)

  source        Source?        @relation(fields: [source_id], references: [id])
  event_sources EventSource[]

  @@map("raw_posts")
}

model Event {
  id                     String                       @id @default(uuid()) @db.Uuid
  city_slug              String?
  title                  String
  event_type             String
  action_type            String                       @default("attend")
  datetime_iso           DateTime?                    @db.Timestamptz(6)
  datetime_text_raw      String?
  end_datetime_iso       DateTime?                    @db.Timestamptz(6)
  location_text          String?
  location_specificity   String?
  lat                    Decimal?                     @db.Decimal(9, 6)
  lng                    Decimal?                     @db.Decimal(9, 6)
  organizer              String?
  cause_tags             String[]                     @default([])
  language               String                       @default("en")
  signup_url             String?
  source_image_url       String?
  capacity               Int?
  signup_deadline        DateTime?                    @db.Timestamptz(6)
  status                 String                       @default("upcoming")
  extraction_confidence  Decimal?                     @db.Decimal(3, 2)
  embedding              Unsupported("vector(1024)")?
  created_at             DateTime                     @default(now()) @db.Timestamptz(6)

  city          City?          @relation(fields: [city_slug], references: [slug])
  flags         EventFlag[]
  event_sources EventSource[]
  submissions   Submission[]
  comments      EventComment[]
  saves         EventSave[]

  @@index([datetime_iso])
  @@map("events")
}

model EventSource {
  event_id    String @db.Uuid
  raw_post_id String @db.Uuid

  event    Event   @relation(fields: [event_id], references: [id], onDelete: Cascade)
  raw_post RawPost @relation(fields: [raw_post_id], references: [id], onDelete: Cascade)

  @@id([event_id, raw_post_id])
  @@map("event_sources")
}

model EventFlag {
  id                       String   @id @default(uuid()) @db.Uuid
  event_id                 String?  @db.Uuid
  city_slug                String?
  flag_type                String
  severity                 String   @default("caution")
  lat                      Decimal  @db.Decimal(9, 6)
  lng                      Decimal  @db.Decimal(9, 6)
  note                     String?
  reporter_session_id      String
  confirmation_count       Int      @default(1)
  status                   String   @default("pending")
  safety_review_reasoning  String?
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  expires_at               DateTime @db.Timestamptz(6)

  event Event? @relation(fields: [event_id], references: [id], onDelete: Cascade)
  city  City?  @relation(fields: [city_slug], references: [slug])

  @@index([created_at(sort: Desc)])
  @@map("event_flags")
}

model FlagTypeConfig {
  flag_type           String   @id
  default_ttl_minutes Int
  icon                String?
  color               String?
  display_label_es    String?
  display_label_en    String?
  applicable_cities   String[] @default(["nyc", "guatemala_city"])

  @@map("flag_type_config")
}

model Submission {
  id                   String    @id @default(uuid()) @db.Uuid
  city_slug            String?
  submitted_by_session String?
  submission_type      String
  payload              String
  status               String    @default("pending")
  result_event_id      String?   @db.Uuid
  rejection_reason     String?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  processed_at         DateTime? @db.Timestamptz(6)

  city  City?  @relation(fields: [city_slug], references: [slug])
  event Event? @relation(fields: [result_event_id], references: [id])

  @@map("submissions")
}

model UserSession {
  id                          String    @id
  city_slug                   String?
  cause_prefs                 String[]  @default([])
  action_prefs                String[]  @default(["attend"])
  language                    String    @default("en")
  neighborhood                String?
  email                       String?
  display_name                String?
  verified_at                 DateTime? @db.Timestamptz(6)
  email_verification_token    String?   @unique
  email_verification_expires  DateTime? @db.Timestamptz(6)
  created_at                  DateTime  @default(now()) @db.Timestamptz(6)

  city     City?          @relation(fields: [city_slug], references: [slug])
  comments EventComment[]
  saves    EventSave[]

  @@index([email])
  @@map("user_sessions")
}

model EventSave {
  session_id String
  event_id   String   @db.Uuid
  status     String   @default("saved")
  note       String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  event   Event       @relation(fields: [event_id], references: [id], onDelete: Cascade)
  session UserSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@id([session_id, event_id])
  @@index([session_id, status])
  @@map("event_saves")
}

model EventComment {
  id                       String   @id @default(uuid()) @db.Uuid
  event_id                 String   @db.Uuid
  session_id               String
  body                     String
  status                   String   @default("approved")
  safety_review_reasoning  String?
  created_at               DateTime @default(now()) @db.Timestamptz(6)

  event   Event       @relation(fields: [event_id], references: [id], onDelete: Cascade)
  session UserSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([event_id, created_at(sort: Desc)])
  @@map("event_comments")
}

model AgentRun {
  id              String   @id @default(uuid()) @db.Uuid
  session_id      String?
  agent_name      String
  input_summary   String?
  output_summary  String?
  reasoning_trace Json?
  duration_ms     Int?
  model           String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("agent_runs")
}
